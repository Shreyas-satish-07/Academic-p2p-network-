# Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection URI (Atlas connection string or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_database_username:your_url_encoded_password@cluster0.example.mongodb.net/cohort?retryWrites=true&w=majority

# Secret key used for signing JWT tokens (use a strong random 32+ character string)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# JWT token expiration window
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin URL for CORS
CLIENT_URL=http://localhost:5173
